# build outputs
/build/
/cmake-build-*/

# ggml is a git submodule at third_party/ggml (see CMakeLists.txt); its build
# outputs live under /build/. Nothing to ignore here beyond the generic *.o below.
*.o
*.a
*.so

# Python
.venv/
venv/
__pycache__/
*.pyc
.eggs/

# generated feature headers are committed (they are inputs), but keep the
# npz source out of git unless deliberately vendored
tools/assets/mel_filters.npz

# test reference dump, regenerated by tests/flow_reference.py (needs flow.pt)
tests/flow_ref.npz

# test reference dump, regenerated by tests/hift_reference.py (needs hift.pt)
tests/hift_ref.npz

# LLM test reference dumps, regenerated by tests/{llm_reference,llm_decode_reference,
# llm_decode_seq_reference,llm_sample_reference,generate_reference}.py (need llm.pt)
tests/llm_ref.npz
tests/llm_decode_ref.npz
tests/llm_decode_seq_ref.npz
tests/llm_sample_ref.npz
tests/llm_zeroshot_ref.npz
tests/generate_inputs.npz

# tokenizer ground-truth cases, regenerated by tests/tokenizer_reference.py
tests/tokenizer_cases.bin

# acceptance-gate generated audio + captured flow inputs (tests/acceptance_wavs.py)
/wavs/
/wavs_*/

# local checkpoints / converted weights
*.pt
*.pth
*.gguf

# editor / OS
.vscode/
.idea/
*.swp
.DS_Store
